# Copy to .env and fill in. Never commit .env (see .gitignore).
# OPENAI_API_KEY is OPTIONAL — viral scoring works rule-based without it.
# It only enables the LLM re-rank in server/viral.py (paid per use).

OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini

# faster-whisper model: tiny | base | small | medium | large-v3
# small = the model used for the approved v3 captions. tiny/base are
# faster but less accurate on word timings; medium is slower.
WHISPER_MODEL=small

# Reject videos longer than this (minutes). A 4 h live at 1080p is
# several GB — keep the limit low on small servers.
MAX_VIDEO_MINUTES=240

# Where finished cuts are saved. Default: ~/Videos/FrogNews-Cortes.
# The user picks this when running iniciar / run_local.py, and can
# change it later in the site or via POST /settings/output-dir.
# It is stored in local_config.json (never committed).
JOBS_DIR=jobs
OUTPUT_DIR=

# Comma-separated origins allowed to call the API, e.g. the GitHub
# Pages URL of the web app. "*" is fine for local testing only.
# The server always allows http://localhost:8000 and its own LAN IP.
CORS_ORIGINS=*

# Port for docker-compose / local uvicorn.
PORT=8000

# Max seconds a single ffmpeg render may run before it is killed.
RENDER_TIMEOUT_SECONDS=1200
